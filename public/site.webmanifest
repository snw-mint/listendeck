{
  "id": "/",
  "name": "listendeck.",
  "short_name": "listendeck",
  "description": "Open-source browser music utilities for ListenBrainz charts, taste match, LRCLIB lyric cards, and Deezer cover cards.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#5B52B6",
  "background_color": "#FAFAFA",
